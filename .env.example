# finance-agent provider 配置（两种来源，pi 优先）
#
# 来源 1（推荐）：无需任何配置——自动复用 pi 的 ~/.pi/agent/{models.json, auth.json}
#   当前模型：pa/gpt-5.6-sol（研究主力，novita-gpt）、kimi-k3 / ZHIPU/GLM-5.3 /
#   deepseek-v4-pro-0813（dashscope，fast 角色等）
#
# 来源 2：.env 三件套（无 pi 配置时生效；只有三件套齐全的 provider 才会注册）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.novita.ai/openai/v1
OPENAI_MODEL=pa/gpt-5.6-sol

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-v4-pro-0813

# 代理固化（可选）：serve 启动时注入进程环境；显式设置的环境变量优先，不会被覆盖
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# ===== 数据源 key（缺 key 的源 fail-closed 不注册，启动时打印提示） =====
# web_search（Exa，B 级）主通道：Novita 网关的 Exa passthrough
#   POST https://api.novita.ai/v3/exa/search + Authorization: Bearer <key>
NOVITA_API_KEY=
# 回退通道：直连 Exa 官方端点（x-api-key）——仅在未配 NOVITA_API_KEY 时生效
EXA_API_KEY=
# web_search_tavily（Tavily，C 级）：Exa 的备份/并集搜索源
TAVILY_API_KEY=

# LLM 读超时秒数（可选，默认 180；大上下文研究轮流式生成可超 60s）
# FINANCE_AGENT_LLM_TIMEOUT=180
